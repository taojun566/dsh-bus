{
  "name": "dsh-bus",
  "version": "1.4.0",
  "description": "Cross-window file-mailbox bus for DSH (and any process): send tasks, wait for receipts, relay work between agent sessions. Zero-dependency core, exactly-once claims, at-least-once delivery.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taojun566/dsh-bus.git"
  },
  "bin": {
    "dsh-bus": "./dshbus-launcher.js"
  },
  "main": "./dshbus-launcher.js",
  "exports": {
    "./locale/*": "./dsh-bundle/locale/*",
    "./icon.svg": "./dsh-bundle/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dshbus.py",
    "dshbus_mcp.py",
    "dshbus-launcher.js",
    "cordis.patch.yml",
    "dsh-bundle/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "dsh.bundle.patch": "cordis.patch.yml",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "message-bus",
    "file-mailbox",
    "cross-window",
    "agent-ipc",
    "window-relay"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-alpha.0 <0.3.0"
  }
}
